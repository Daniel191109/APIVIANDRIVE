<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.MainPage"
             Title="VIANDRIVE"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <ContentPage.Resources>
        <Style x:Key="MainEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="PlaceholderColor" Value="#808080" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="MainPickerStyle" TargetType="Picker">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="TitleColor" Value="#808080" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- HEADER -->
            <Border BackgroundColor="#121212"
                    Padding="25,45,25,35"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,0,35">
                <VerticalStackLayout Spacing="16">
                    <Border WidthRequest="82" HeightRequest="82" HorizontalOptions="Center" BackgroundColor="#1A1A1A" Stroke="#F5B800" StrokeThickness="2" StrokeShape="RoundRectangle 26">
                        <Image Source="logo.jpg" Aspect="AspectFit" Margin="8" />
                    </Border>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="VianDrive" FontSize="32" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                        <Label Text="Tu seguridad es nuestro camino" FontSize="12" CharacterSpacing="1" TextColor="#F5B800" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                        <Label Text="Registro de Cliente" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                        <Label Text="Crea tu cuenta y comienza a viajar" FontSize="13" TextColor="#A0A0A0" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- FORMULARIO -->
            <VerticalStackLayout Padding="22,0,22,25" Spacing="18" Margin="0,-20,0,0">
                <Border BackgroundColor="#121212" Stroke="#2A2A2A" StrokeThickness="1" Padding="22" StrokeShape="RoundRectangle 24">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,6" Radius="18" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Crear cuenta" FontSize="21" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Completa tus datos para registrarte" FontSize="13" TextColor="#A0A0A0" />
                        </VerticalStackLayout>

                        <!-- ============================================= -->
                        <!-- PASO 1: DATOS DEL CLIENTE (VISIBLE AL INICIO) -->
                        <!-- ============================================= -->
                        <VerticalStackLayout x:Name="PanelDatosRegistro" Spacing="16" IsVisible="True">

                            <!-- NOMBRE -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nombre completo" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="●" FontSize="18" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="NombreEntry" Style="{StaticResource MainEntryStyle}" Placeholder="Ingresa tu nombre completo" ReturnType="Next" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- CORREO -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Correo electrónico" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="✉" FontSize="21" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="CorreoEntry" Style="{StaticResource MainEntryStyle}" Placeholder="correo@ejemplo.com" Keyboard="Email" ClearButtonVisibility="WhileEditing" ReturnType="Next" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- CONTRASEÑA -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Contraseña" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="●" FontSize="18" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="ClaveEntry" Style="{StaticResource MainEntryStyle}" Placeholder="Crea una contraseña" IsPassword="True" ReturnType="Next" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- TELEFONO -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Celular" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="☎" FontSize="20" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="TelefonoEntry" Style="{StaticResource MainEntryStyle}" Placeholder="Número de celular" Keyboard="Telephone" ReturnType="Next" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- METODO DE PAGO -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Método de pago preferido" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="$" FontSize="22" FontAttributes="Bold" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Picker Grid.Column="1" x:Name="MetodoPagoPicker" Style="{StaticResource MainPickerStyle}" Title="Selecciona un método">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Nequi</x:String>
                                                    <x:String>Daviplata</x:String>
                                                    <x:String>Bancolombia</x:String>
                                                    <x:String>Otro</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- BOTON CONTINUAR -->
                            <Button x:Name="ContinuarButton"
                                    Text="Continuar y verificar correo →"
                                    Clicked="OnContinuarRegistroClicked"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#000000"
                                    BackgroundColor="#F5B800"
                                    CornerRadius="16"
                                    HeightRequest="58"
                                    Margin="0,5,0,0" />

                        </VerticalStackLayout>


                        <!-- ============================================= -->
                        <!-- PASO 2: VERIFICACIÓN DE TOKEN (OCULTO)        -->
                        <!-- ============================================= -->
                        <VerticalStackLayout x:Name="PanelTokenVerification" Spacing="16" IsVisible="False">

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Verificación de correo" FontSize="18" FontAttributes="Bold" TextColor="#F5B800" />
                                <Label Text="Hemos enviado un código de 6 dígitos a tu correo electrónico." FontSize="13" TextColor="#D0D0D0" />
                            </VerticalStackLayout>

                            <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Text="🔒" FontSize="20" TextColor="#F5B800" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" 
                                           x:Name="TokenEntry" 
                                           Style="{StaticResource MainEntryStyle}" 
                                           Placeholder="Código de 6 dígitos" 
                                           Keyboard="Numeric" 
                                           MaxLength="6" />
                                </Grid>
                            </Border>

                            <Button x:Name="RegistrarFinalButton"
                                    Text="Registrar cliente"
                                    Clicked="OnRegistrarUsuarioFinalClicked"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#000000"
                                    BackgroundColor="#F5B800"
                                    CornerRadius="16"
                                    HeightRequest="58" />

                            <Button Text="← Volver a editar datos"
                                    Clicked="OnVolverDatosClicked"
                                    FontSize="13"
                                    TextColor="#A0A0A0"
                                    BackgroundColor="Transparent"
                                    HeightRequest="40" />

                        </VerticalStackLayout>


                        <!-- UBICACIÓN -->
                        <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 15" Margin="0,2,0,0">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Ubicación" FontSize="12" FontAttributes="Bold" TextColor="#F5B800" />
                                <Label x:Name="lblOrigen" Text="Origen detectado:" FontSize="14" TextColor="#D0D0D0" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- SEGURIDAD -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="7">
                    <Label Text="●" FontSize="9" TextColor="#F5B800" VerticalOptions="Center" />
                    <Label Text="Tus datos están protegidos" FontSize="12" TextColor="#808080" VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- FOOTER -->
            <Label Text="VIANDRIVE • MOVILIDAD A TU MEDIDA" FontSize="9" CharacterSpacing="1.2" TextColor="#666666" HorizontalOptions="Center" Margin="0,0,0,18" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>