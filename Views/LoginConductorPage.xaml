<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ViandriveApp.Views.LoginConductorPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             Title="Login Conductor" 
             Shell.NavBarIsVisible="False" 
             BackgroundColor="#0B0C10">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER ESTILO FUTURISTA -->
        <Border Grid.Row="0" 
                BackgroundColor="#15161C" 
                StrokeThickness="0" 
                Padding="24,50,24,35" 
                StrokeShape="RoundRectangle 0,0,32,32">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="15" Opacity="0.6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="78" HeightRequest="78" BackgroundColor="#0F1015" Stroke="#00E5FF" StrokeThickness="1.5" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.3" />
                    </Border.Shadow>
                    <Label Text="🚗" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="VIANDRIVE" FontSize="14" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="3" HorizontalOptions="Center" />
                <Label Text="Acceso de Conductor" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                <Label Text="Ingresa con tu documento y contraseña" FontSize="13" TextColor="#A0A2B1" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO FORMULARIO -->
        <ScrollView Grid.Row="1" VerticalOptions="Fill" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,30,24,40" Spacing="24">

                <Border BackgroundColor="#15161C" 
                        Stroke="#2B2C36" 
                        StrokeThickness="1.5" 
                        Padding="24" 
                        StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="20">

                        <!-- DOCUMENTO -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="DOCUMENTO DE IDENTIDAD" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />

                            <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Text="🪪" FontSize="20" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" 
                                           x:Name="CedulaEntry" 
                                           Placeholder="Número de documento" 
                                           Keyboard="Numeric" 
                                           MaxLength="15" 
                                           TextColor="#FFFFFF" 
                                           PlaceholderColor="#4A4C5A" 
                                           BackgroundColor="Transparent" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- CONTRASEÑA CON OJITO -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />

                            <!-- Se agregó la 3ra columna (Auto) para el botón del ojito -->
                            <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4,4,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                    <Label Text="🔒" FontSize="20" TextColor="#00E5FF" VerticalOptions="Center" />

                                    <Entry Grid.Column="1" 
                                           x:Name="PasswordEntry" 
                                           Placeholder="Tu contraseña" 
                                           IsPassword="True" 
                                           TextColor="#FFFFFF" 
                                           PlaceholderColor="#4A4C5A" 
                                           BackgroundColor="Transparent" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />

                                    <!-- BOTÓN OJITO -->
                                    <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="48" VerticalOptions="Fill">
                                        <Label x:Name="TogglePasswordIcon" Text="👁️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTogglePasswordVisibilityTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ENLACE: OLVIDÉ MI CONTRASEÑA -->
                            <Label Text="¿Olvidaste tu contraseña?" 
                                   TextColor="#A0A2B1" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   TextDecorations="Underline"
                                   HorizontalOptions="End" 
                                   Margin="0,4,4,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOlvidePasswordTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Botones de Acción -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            <Button Text="INICIAR SESIÓN" 
                                    Clicked="OnLoginClicked" 
                                    BackgroundColor="#00E676" 
                                    TextColor="#0B0C10" 
                                    FontSize="14" 
                                    FontAttributes="Bold" 
                                    HeightRequest="56" 
                                    CornerRadius="16" 
                                    CharacterSpacing="1" />

                            <Button Text="ACCESO RÁPIDO (PRUEBA)" 
                                    Clicked="OnAccesoRapidoClicked" 
                                    BackgroundColor="#1A1B22" 
                                    TextColor="#00E5FF" 
                                    BorderColor="#00E5FF" 
                                    BorderWidth="1" 
                                    FontSize="12" 
                                    FontAttributes="Bold" 
                                    HeightRequest="56" 
                                    CornerRadius="16" 
                                    CharacterSpacing="1" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="VIANDRIVE • MOVILIDAD A TU MEDIDA" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       TextColor="#4A4C5A" 
                       HorizontalOptions="Center" 
                       CharacterSpacing="1" 
                       Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>