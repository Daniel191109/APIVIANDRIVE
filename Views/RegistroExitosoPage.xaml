<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.RegistroExitosoPage"
             Title="¡Registro exitoso!">

    <StackLayout Padding="30" Spacing="25" VerticalOptions="Center">
        <Label Text="¡Registro completado!" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Label x:Name="NombreLabel" FontSize="18" HorizontalOptions="Center"/>
        <Label x:Name="PlacaLabel" FontSize="18" HorizontalOptions="Center"/>
        <Label x:Name="ColorLabel" FontSize="18" HorizontalOptions="Center"/>
        <Button Text="Ir al inicio" Clicked="OnIrInicioClicked" BackgroundColor="#7ED957" TextColor="Black"/>
    </StackLayout>
</ContentPage>
