<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.ConfirmarViajePage"
             BackgroundColor="#0B0C10"
             Shell.NavBarIsVisible="False">

    <Grid Padding="20">
        <!-- Tarjeta Flotante (Glassmorphism Oscuro) -->
        <Border BackgroundColor="#15161C"
                Stroke="#00E5FF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="24,32"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="340">
            <Border.Shadow>
                <Shadow Brush="#00E5FF" Offset="0,0" Radius="30" Opacity="0.15" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="24">

                <!-- Ícono Decorativo -->
                <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32" BackgroundColor="#1A00E5FF" Stroke="Transparent" HorizontalOptions="Center">
                    <Label Text="📍" HorizontalOptions="Center" VerticalOptions="Center" FontSize="28" />
                </Border>

                <!-- Título -->
                <Label Text="CONFIRMAR VIAJE"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#00E5FF" 
                       CharacterSpacing="1" />

                <!-- Resumen Dinámico (Mantiene tu x:Name original) -->
                <Label x:Name="ResumenLabel"
                       FontSize="15"
                       TextColor="#A0A2B1"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.4" />

                <!-- Botones de Acción Responsivos -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,10,0,0">
                    <Button Grid.Column="0" 
                            Text="CANCELAR"
                            Clicked="Cancelar_Clicked"
                            BackgroundColor="#1A1B22"
                            TextColor="#FF3366"
                            BorderColor="#FF3366"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="52"
                            CharacterSpacing="1" />

                    <Button Grid.Column="1" 
                            Text="CONFIRMAR"
                            Clicked="ConfirmarViaje_Clicked"
                            BackgroundColor="#00E676"
                            TextColor="#0B0C10"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="52"
                            CharacterSpacing="1" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>