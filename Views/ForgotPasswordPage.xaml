<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.ForgotPasswordPage"
             Title="Recuperar contraseña"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <ContentPage.Resources>
        <Style x:Key="ForgotEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="PlaceholderColor" Value="#808080" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Padding="28,45,28,30"
                StrokeThickness="0"
                BackgroundColor="#121212"
                StrokeShape="RoundRectangle 0,0,0,35">

            <VerticalStackLayout Spacing="10">
                <Border WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center"
                        BackgroundColor="#1A1A1A"
                        Stroke="#F5B800"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 24">
                    <Label Text="🔑" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="VIANDRIVE" FontSize="13" FontAttributes="Bold" TextColor="#F5B800" CharacterSpacing="2" HorizontalOptions="Center" />
                <Label Text="Recuperar contraseña" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                <Label x:Name="lblSubtituloHeader" Text="Te ayudaremos a restablecer tu acceso" FontSize="13" TextColor="#A0A0A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Grid.Row="1" Margin="0,-15,0,0">
            <VerticalStackLayout Padding="22,0,22,25" Spacing="18">

                <Border BackgroundColor="#121212"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="22"
                        StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="18">

                        <!-- ============================================== -->
                        <!-- PASO 1: SOLICITAR CORREO                       -->
                        <!-- ============================================== -->
                        <VerticalStackLayout x:Name="PanelSolicitarCorreo" Spacing="16" IsVisible="True">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Ingresa tu correo" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                                <Label Text="Te enviaremos un código de seguridad de 6 dígitos para verificar tu identidad." FontSize="13" TextColor="#A0A0A0" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Correo electrónico" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="✉" FontSize="21" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="CorreoEntry" Style="{StaticResource ForgotEntryStyle}" Placeholder="correo@ejemplo.com" Keyboard="Email" ClearButtonVisibility="WhileEditing" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Button x:Name="EnviarCodigoButton"
                                    Text="Enviar código de verificación →"
                                    Clicked="OnEnviarCodigoClicked"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#000000"
                                    BackgroundColor="#F5B800"
                                    CornerRadius="16"
                                    HeightRequest="56"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>

                        <!-- ============================================== -->
                        <!-- PASO 2: VERIFICAR CÓDIGO/TOKEN                 -->
                        <!-- ============================================== -->
                        <VerticalStackLayout x:Name="PanelVerificarCodigo" Spacing="16" IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Ingresa el código" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                                <Label x:Name="lblInfoCodigoEnviado" Text="Hemos enviado un código a tu correo." FontSize="13" TextColor="#A0A0A0" />
                            </VerticalStackLayout>

                            <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Text="🔒" FontSize="20" TextColor="#F5B800" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" x:Name="TokenResetEntry" Style="{StaticResource ForgotEntryStyle}" Placeholder="Código de 6 dígitos" Keyboard="Numeric" MaxLength="6" />
                                </Grid>
                            </Border>

                            <Button x:Name="VerificarCodigoButton"
                                    Text="Verificar código"
                                    Clicked="OnVerificarCodigoClicked"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#000000"
                                    BackgroundColor="#F5B800"
                                    CornerRadius="16"
                                    HeightRequest="56" />

                            <Button Text="Reenviar código"
                                    Clicked="OnReenviarCodigoClicked"
                                    FontSize="13"
                                    TextColor="#F5B800"
                                    BackgroundColor="Transparent"
                                    HeightRequest="38" />
                        </VerticalStackLayout>

                        <!-- ============================================== -->
                        <!-- PASO 3: NUEVA CONTRASEÑA                       -->
                        <!-- ============================================== -->
                        <VerticalStackLayout x:Name="PanelNuevaContrasena" Spacing="16" IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nueva contraseña" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                                <Label Text="Crea una contraseña segura para tu cuenta." FontSize="13" TextColor="#A0A0A0" />
                            </VerticalStackLayout>

                            <!-- CONTRASEÑA NUEVA -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nueva contraseña" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="●" FontSize="18" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="NuevaClaveEntry" Style="{StaticResource ForgotEntryStyle}" Placeholder="Ingresa la nueva contraseña" IsPassword="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- CONFIRMAR CONTRASEÑA -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Confirmar contraseña" FontSize="13" FontAttributes="Bold" TextColor="#D0D0D0" />
                                <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="14,4" HeightRequest="62" StrokeShape="RoundRectangle 15">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="🔐" FontSize="18" TextColor="#F5B800" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="ConfirmarNuevaClaveEntry" Style="{StaticResource ForgotEntryStyle}" Placeholder="Repite la contraseña" IsPassword="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Button x:Name="CambiarClaveButton"
                                    Text="Guardar y acceder"
                                    Clicked="OnCambiarClaveClicked"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#000000"
                                    BackgroundColor="#F5B800"
                                    CornerRadius="16"
                                    HeightRequest="56"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- VOLVER AL LOGIN -->
                <Button Text="← Volver al inicio de sesión"
                        Clicked="OnVolverLoginClicked"
                        FontSize="14"
                        TextColor="#A0A0A0"
                        BackgroundColor="Transparent"
                        HeightRequest="42" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER -->
        <Label Grid.Row="2" Text="VIANDRIVE • TU SEGURIDAD ES NUESTRO CAMINO" FontSize="9" CharacterSpacing="1.2" TextColor="#666666" HorizontalOptions="Center" Margin="0,0,0,18" />

    </Grid>
</ContentPage>