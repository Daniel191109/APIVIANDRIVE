<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.MapaOfertaPage"
             BackgroundColor="#0B0C10"
             Shell.NavBarIsVisible="false">

    <Grid RowDefinitions="*">
        <!-- 1. MAPA EN WEBVIEW (FONDO COMPLETO) -->
        <WebView x:Name="MapaWeb"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <!-- 2. GRADIENTES DE SOMBRA Y LECTURA DE MAPA -->
        <BoxView VerticalOptions="Start" HeightRequest="160" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC0B0C10" Offset="0.0" />
                    <GradientStop Color="#000B0C10" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView VerticalOptions="End" HeightRequest="220" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0C10" Offset="0.0" />
                    <GradientStop Color="#E60B0C10" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- 3. ENCABEZADO SUPERIOR (BOTÓN VOLVER Y TARJETA DE RUTA) -->
        <VerticalStackLayout VerticalOptions="Start" 
                             Margin="16,48,16,0" 
                             Spacing="12" 
                             InputTransparent="False">

            <!-- Botón Volver -->
            <Border BackgroundColor="#D9121318" 
                    StrokeShape="RoundRectangle 20" 
                    Stroke="#1F212A" 
                    StrokeThickness="1" 
                    HorizontalOptions="Start" 
                    HeightRequest="40" 
                    Padding="14,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.4" />
                </Border.Shadow>
                <Button Text="⟵ Volver" 
                        BackgroundColor="Transparent" 
                        TextColor="#00E5FF" 
                        FontAttributes="Bold" 
                        FontSize="13" 
                        Padding="0" 
                        Clicked="VolverMapa_Clicked" />
            </Border>

            <!-- Tarjeta de Direcciones (Ancho Completo Fluido) -->
            <Border BackgroundColor="#E6121319" 
                    StrokeShape="RoundRectangle 18" 
                    Stroke="#222430" 
                    StrokeThickness="1.5" 
                    Padding="14" 
                    HorizontalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="12" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="12">

                    <!-- Línea conector vertical entre origen y destino -->
                    <BoxView Grid.RowSpan="2" Grid.Column="0" WidthRequest="2" Color="#2A2D3D" HorizontalOptions="Center" Margin="0,8" />

                    <!-- Punto Origen -->
                    <BoxView Grid.Row="0" Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#00E5FF" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                        <Label Text="RECOGIDA" TextColor="#757784" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" />
                        <Label x:Name="LblOrigenTexto" Text="Cargando origen..." TextColor="White" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Punto Destino -->
                    <BoxView Grid.Row="1" Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF3366" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="1">
                        <Label Text="DESTINO" TextColor="#757784" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" />
                        <Label x:Name="LblDestinoTexto" Text="Cargando destino..." TextColor="White" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- 4. PANEL INFERIOR FLOTANTE DINÁMICO -->
        <Border x:Name="PanelInferior" 
                Margin="16,0,16,24" 
                Padding="18" 
                BackgroundColor="#F2121319" 
                StrokeShape="RoundRectangle 24" 
                Stroke="#222430" 
                StrokeThickness="1.5" 
                HorizontalOptions="Fill" 
                VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,12" Radius="24" Opacity="0.7" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">

                <!-- Título del viaje y Badge de Estado -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="LblTituloEstado" Grid.Column="0" Text="Solicitud de Viaje" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    <Border x:Name="BadgeEstadoContenedor" Grid.Column="1" BackgroundColor="#1A00E5FF" Padding="10,5" StrokeShape="RoundRectangle 10" Stroke="#00E5FF" StrokeThickness="1">
                        <Label x:Name="LblBadgeEstado" Text="NUEVA" TextColor="#00E5FF" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#1F212A" HorizontalOptions="Fill" />

                <!-- Información del Pasajero (Se activa en fase 2 y 3) -->
                <VerticalStackLayout x:Name="LayoutInfoPasajero" Spacing="6" IsVisible="false">
                    <Label Text="PASAJERO" TextColor="#757784" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                    <Border BackgroundColor="#0B0C10" StrokeShape="RoundRectangle 14" Stroke="#1F212A" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" BackgroundColor="#1C1E26" Stroke="Transparent">
                                <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LblNombrePasajero" Text="Cargando..." TextColor="White" FontSize="14" FontAttributes="Bold" />
                                <Label x:Name="LblMedioPago" Text="Efectivo" TextColor="#00E676" FontSize="12" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="#1A00E5FF" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19" Stroke="#00E5FF" StrokeThickness="1" VerticalOptions="Center">
                                <Label Text="📞" TextColor="#00E5FF" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Monto de la Oferta -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label x:Name="LblEtiquetaTarifa" Grid.Column="0" Text="Oferta del usuario:" TextColor="#9A9DB0" FontSize="14" VerticalOptions="Center" />
                    <Label x:Name="LblTarifaSugerida" Grid.Column="1" Text="$7.000" TextColor="#00E676" FontSize="22" FontAttributes="Bold" />
                </Grid>

                <!-- Campo de Contraoferta -->
                <VerticalStackLayout x:Name="LayoutContraoferta" Spacing="6">
                    <Label Text="TU CONTRAOFERTA (OPCIONAL)" TextColor="#757784" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                    <Border BackgroundColor="#0B0C10" StrokeShape="RoundRectangle 14" Stroke="#1F212A" StrokeThickness="1" Padding="14,0" HeightRequest="48">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="$" TextColor="#00E5FF" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Entry x:Name="TxtContraoferta" Grid.Column="1" Placeholder="Ej. 10000" PlaceholderColor="#4A4C5A" TextColor="White" Keyboard="Numeric" FontSize="15" FontAttributes="Bold" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Botones de Acción principales -->
                <Grid x:Name="GridBotonesAccion" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Button x:Name="BtnAccionSecundaria" 
                            Grid.Column="0" 
                            Text="OFERTAR" 
                            BackgroundColor="#1C1E26" 
                            TextColor="#FF9800" 
                            BorderColor="#FF9800" 
                            BorderWidth="1.5" 
                            FontAttributes="Bold" 
                            FontSize="13" 
                            CornerRadius="14" 
                            HeightRequest="50" 
                            CharacterSpacing="1" 
                            Clicked="OnEnviarContraofertaClicked" />

                    <Button x:Name="BtnAccionPrincipal" 
                            Grid.Column="1" 
                            Text="ACEPTAR" 
                            BackgroundColor="#00E676" 
                            TextColor="#0B0C10" 
                            FontAttributes="Bold" 
                            FontSize="13" 
                            CornerRadius="14" 
                            HeightRequest="50" 
                            CharacterSpacing="1" 
                            Clicked="OnAceptarTarifaOriginalClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 5. OVERLAY MODAL DE CALIFICACIÓN -->
        <Grid x:Name="OverlayCalificacion" 
              BackgroundColor="#D9000000" 
              IsVisible="false" 
              InputTransparent="False">
            <Border BackgroundColor="#121319" 
                    Stroke="#00E5FF" 
                    StrokeThickness="1.5" 
                    StrokeShape="RoundRectangle 24" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center" 
                    Padding="24" 
                    WidthRequest="310">
                <Border.Shadow>
                    <Shadow Brush="#00E5FF" Offset="0,0" Radius="30" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Label Text="VIAJE FINALIZADO" TextColor="#00E676" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                    <Label Text="Califica a tu pasajero" TextColor="#9A9DB0" FontSize="13" HorizontalOptions="Center" />

                    <Border WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" BackgroundColor="#1C1E26" Stroke="Transparent" HorizontalOptions="Center" Margin="0,4">
                        <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="26" />
                    </Border>

                    <Label x:Name="LblNombreCalificar" Text="Cargando..." TextColor="White" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />

                    <!-- Selector de Estrellas -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,6">
                        <Label x:Name="Star1" Text="★" ClassId="1" FontSize="34" TextColor="#FFD700">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Estrella_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="Star2" Text="★" ClassId="2" FontSize="34" TextColor="#FFD700">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Estrella_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="Star3" Text="★" ClassId="3" FontSize="34" TextColor="#FFD700">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Estrella_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="Star4" Text="★" ClassId="4" FontSize="34" TextColor="#FFD700">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Estrella_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="Star5" Text="★" ClassId="5" FontSize="34" TextColor="#FFD700">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Estrella_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Button x:Name="BtnEnviarCalificacion" 
                            Text="FINALIZAR" 
                            BackgroundColor="#00E5FF" 
                            TextColor="#0B0C10" 
                            FontAttributes="Bold" 
                            CornerRadius="14" 
                            HeightRequest="48" 
                            Margin="0,6,0,0" 
                            CharacterSpacing="1" 
                            Clicked="EnviarCalificacion_Clicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>