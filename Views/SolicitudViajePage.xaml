<ContentPage
    x:Class="ViandriveApp.Views.SolicitudViajePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Solicitud de viaje">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Padding="20">

       
        <ContentView x:Name="MapaContenedor" Grid.Row="0" />

       
        <Entry x:Name="DestinoEntry"
               Placeholder="A donde vas"
               Grid.Row="1"
               Margin="0,10"
               FontSize="16" />

        
        <Label x:Name="TarifaLabel"
               Text="Tarifa estimada: $0"
               FontAttributes="Bold"
               FontSize="16"
               Grid.Row="2"
               Margin="0,10" />

       
        <Button
            Text="Enviar solicitud"
            Grid.Row="3"
            BackgroundColor="#4CAF50"
            TextColor="White"
            FontAttributes="Bold"
            Clicked="EnviarSolicitud_Clicked"
            Margin="0,20" />
    </Grid>
</ContentPage>
