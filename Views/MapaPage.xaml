<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViandriveApp.Views.MapaPage"
             Title="Mapa de viaje"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B0C10">

    <ContentPage.Resources>
        <Style x:Key="MapaEntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="PlaceholderColor" Value="#4A4C5A" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>

        <Style x:Key="MapaPickerStyle" TargetType="Picker">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TitleColor" Value="#4A4C5A" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <!-- CAPA 1: MAPA HERO -->
            <Grid>
                <WebView x:Name="MapaWeb" 
                         HorizontalOptions="Fill" 
                         VerticalOptions="Fill" 
                         BackgroundColor="#0B0C10" />

                <!-- Gradiente superior -->
                <BoxView VerticalOptions="Start" HeightRequest="120" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Píldora de estado superior (Centrada) -->
                <Border VerticalOptions="Start" 
                        HorizontalOptions="Center"
                        Margin="0,50,0,0"
                        BackgroundColor="#CC15161C"
                        Stroke="#00E5FF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="16,8">
                    <Border.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,4" Radius="10" Opacity="0.2" />
                    </Border.Shadow>
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="VIANDRIVE" FontSize="13" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" VerticalOptions="Center"/>
                        <BoxView WidthRequest="6" HeightRequest="6" Color="#00E676" CornerRadius="3" VerticalOptions="Center"/>
                        <Label Text="Buscando" FontSize="12" TextColor="#00E676" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- NUEVO: Botón Flotante Perfil de Usuario (Esquina Superior Derecha) -->
                <Button Text="👤"
                        FontSize="20"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,50,20,0"
                        WidthRequest="45"
                        HeightRequest="45"
                        CornerRadius="22"
                        BackgroundColor="#1A1B24"
                        BorderColor="#2B2C36"
                        BorderWidth="1.5"
                        Padding="0"
                        Clicked="BtnIrUsuario_Clicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.4" />
                    </Button.Shadow>
                </Button>
            </Grid>

            <!-- CAPA 2: BOTTOM SHEET DINÁMICO -->
            <Border BackgroundColor="#F215161C"
                    Stroke="#2B2C36"
                    StrokeThickness="1.5"
                    Padding="20,15,20,30"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 32,32,0,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-8" Radius="20" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <BoxView Color="#2B2C36" HeightRequest="4" WidthRequest="40" CornerRadius="2" HorizontalOptions="Center" Margin="0,0,0,5"/>

                    <Label Text="¿A dónde vamos hoy?" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" CharacterSpacing="0.5" />

                    <!-- CAMPO DESTINO -->
                    <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="12,2" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF3366" VerticalOptions="Center" />
                            <Entry Grid.Column="1" x:Name="DestinoEntry" Placeholder="Busca tu destino..." Style="{StaticResource MapaEntryStyle}" />
                        </Grid>
                    </Border>

                    <!-- LISTA DE SUGERENCIAS -->
                    <ListView x:Name="SugerenciasListView" IsVisible="False" HeightRequest="140" SelectionMode="Single" ItemSelected="SugerenciasListView_ItemSelected" BackgroundColor="#0B0C10" SeparatorColor="#2B2C36" HasUnevenRows="True" Margin="0,-10,0,0"/>

                    <!-- GRID: OFERTA Y MÉTODO DE PAGO -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <!-- Oferta -->
                        <Border Grid.Column="0" BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="12,8" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="TU OFERTA" FontSize="10" FontAttributes="Bold" TextColor="#757784" CharacterSpacing="1" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="$" FontSize="16" FontAttributes="Bold" TextColor="#00E5FF" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" x:Name="OfertaEntry" Text="6500" Keyboard="Numeric" Placeholder="6500" TextChanged="OfertaEntry_TextChanged" Style="{StaticResource MapaEntryStyle}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Pago -->
                        <Border Grid.Column="1" BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="12,8" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="MÉTODO DE PAGO" FontSize="10" FontAttributes="Bold" TextColor="#757784" CharacterSpacing="1" />
                                <Picker x:Name="MedioPagoPicker" Title="Seleccionar" Style="{StaticResource MapaPickerStyle}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Daviplata</x:String>
                                            <x:String>Nequi</x:String>
                                            <x:String>Efectivo</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="SOLICITAR VIAJE" Clicked="SolicitarViajeDesdeMapa_Clicked" BackgroundColor="#00E5FF" TextColor="#0B0C10" FontSize="14" FontAttributes="Bold" HeightRequest="54" CornerRadius="16" CharacterSpacing="1" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- CAPA 3: OVERLAY MODAL MULTICONDUCTOR -->
            <Grid x:Name="OverlayPropuestaConductor" BackgroundColor="#F2000000" IsVisible="false" InputTransparent="False">
                <Border BackgroundColor="#121319" 
                        Stroke="#00E5FF" 
                        StrokeThickness="1.5" 
                        StrokeShape="RoundRectangle 24" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        Padding="16,20" 
                        WidthRequest="340"
                        MaximumHeightRequest="520">
                    <Border.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="30" Opacity="0.3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="¡CONDUCTORES DISPONIBLES!" TextColor="#00E5FF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                        <Label Text="Elige la opción que prefieras para tu viaje:" TextColor="#8F92A1" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                        <!-- LISTA DINÁMICA DE CONDUCTORES POSTULADOS -->
                        <CollectionView x:Name="CvConductoresDisponibles" HeightRequest="280" SelectionMode="None" Margin="0,4">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#1A1B24" Stroke="#2A2B36" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="10">
                                            <!-- Avatar / Foto -->
                                            <Border Grid.Row="0" Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#222430" Stroke="Transparent">
                                                <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" />
                                            </Border>

                                            <!-- Datos Conductor y Auto -->
                                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding NombreConductor}" TextColor="White" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding VehiculoInfo}" TextColor="#8F92A1" FontSize="11" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Puntuación -->
                                            <Border Grid.Row="0" Grid.Column="2" BackgroundColor="#102528" Padding="6,3" StrokeShape="RoundRectangle 8" Stroke="#00E5FF" StrokeThickness="0.5" VerticalOptions="Start">
                                                <Label Text="{Binding CalificacionTexto}" TextColor="#00E5FF" FontSize="10" FontAttributes="Bold"/>
                                            </Border>

                                            <!-- Tarifa y Botón Seleccionar -->
                                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding TarifaTexto}" TextColor="#00E676" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />

                                            <Button Grid.Row="1" Grid.Column="2" 
                                                    Text="ELEGIR" 
                                                    BackgroundColor="#00E676" 
                                                    TextColor="#0B0C10" 
                                                    FontAttributes="Bold" 
                                                    FontSize="11" 
                                                    CornerRadius="10" 
                                                    HeightRequest="36" 
                                                    Padding="14,0"
                                                    Clicked="BtnElegirConductorEspecifico_Clicked"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="CANCELAR BÚSQUEDA" 
                                BackgroundColor="#1A1B22" 
                                TextColor="#FF3366" 
                                BorderColor="#FF3366" 
                                BorderWidth="1" 
                                FontAttributes="Bold" 
                                FontSize="11" 
                                CornerRadius="12" 
                                HeightRequest="44" 
                                Clicked="BtnCancelarBusqueda_Clicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>