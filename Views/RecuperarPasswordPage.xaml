<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ViandriveApp.Views.RecuperarPasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Recuperar Contraseña"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B0C10">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER ESTILO FUTURISTA -->
        <Border Grid.Row="0" 
                BackgroundColor="#15161C" 
                StrokeThickness="0" 
                Padding="24,50,24,35" 
                StrokeShape="RoundRectangle 0,0,32,32">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="15" Opacity="0.6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="78" HeightRequest="78" BackgroundColor="#0F1015" Stroke="#00E5FF" StrokeThickness="1.5" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.3" />
                    </Border.Shadow>
                    <Label Text="🔐" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="RECUPERACIÓN" FontSize="14" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="3" HorizontalOptions="Center" />
                <Label Text="Restablece tu acceso" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />

                <!-- Subtítulo dinámico manejado desde C# -->
                <Label x:Name="lblSubtituloHeader" Text="Ingresa tu correo para recibir el código" FontSize="13" TextColor="#A0A2B1" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1" VerticalOptions="Fill" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,30,24,40" Spacing="24">

                <Border BackgroundColor="#15161C" 
                        Stroke="#2B2C36" 
                        StrokeThickness="1.5" 
                        Padding="24" 
                        StrokeShape="RoundRectangle 24">

                    <Grid>
                        <!-- ========================================== -->
                        <!-- PASO 1: SOLICITAR CORREO                   -->
                        <!-- ========================================== -->
                        <VerticalStackLayout x:Name="PanelSolicitarCorreo" IsVisible="True" Spacing="20">

                            <VerticalStackLayout Spacing="8">
                                <Label Text="CORREO ELECTRÓNICO REGISTRADO" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />
                                <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="✉" FontSize="20" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="CorreoEntry" Placeholder="ejemplo@correo.com" Keyboard="Email" TextColor="#FFFFFF" PlaceholderColor="#4A4C5A" BackgroundColor="Transparent" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                                <Button Text="ENVIAR CÓDIGO" Clicked="OnEnviarCodigoClicked" BackgroundColor="#00E676" TextColor="#0B0C10" FontSize="14" FontAttributes="Bold" HeightRequest="56" CornerRadius="16" CharacterSpacing="1" />
                                <Button Text="VOLVER AL LOGIN" Clicked="OnVolverLoginClicked" BackgroundColor="Transparent" TextColor="#A0A2B1" FontSize="13" FontAttributes="Bold" HeightRequest="48" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>


                        <!-- ========================================== -->
                        <!-- PASO 2: VERIFICAR CÓDIGO                   -->
                        <!-- ========================================== -->
                        <VerticalStackLayout x:Name="PanelVerificarCodigo" IsVisible="False" Spacing="20">

                            <!-- Etiqueta dinámica para mostrar el correo al que se envió -->
                            <Label x:Name="lblInfoCodigoEnviado" FontSize="13" TextColor="#A0A2B1" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />

                            <VerticalStackLayout Spacing="8">
                                <Label Text="CÓDIGO DE VERIFICACIÓN" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />
                                <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="💬" FontSize="20" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" x:Name="TokenResetEntry" Placeholder="Ej: 123456" Keyboard="Numeric" MaxLength="6" TextColor="#FFFFFF" PlaceholderColor="#4A4C5A" BackgroundColor="Transparent" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" CharacterSpacing="5" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                                <Button Text="VERIFICAR CÓDIGO" Clicked="OnVerificarCodigoClicked" BackgroundColor="#00E5FF" TextColor="#0B0C10" FontSize="14" FontAttributes="Bold" HeightRequest="56" CornerRadius="16" CharacterSpacing="1" />
                                <Button Text="REENVIAR CÓDIGO" Clicked="OnReenviarCodigoClicked" BackgroundColor="Transparent" TextColor="#00E5FF" FontSize="13" FontAttributes="Bold" HeightRequest="48" />
                                <Button Text="CANCELAR" Clicked="OnVolverLoginClicked" BackgroundColor="Transparent" TextColor="#A0A2B1" FontSize="13" FontAttributes="Bold" HeightRequest="48" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>


                        <!-- ========================================== -->
                        <!-- PASO 3: NUEVA CONTRASEÑA                   -->
                        <!-- ========================================== -->
                        <VerticalStackLayout x:Name="PanelNuevaContrasena" IsVisible="False" Spacing="20">

                            <VerticalStackLayout Spacing="8">
                                <Label Text="NUEVA CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />
                                <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="🔒" FontSize="20" VerticalOptions="Center" TextColor="#00E5FF"/>
                                        <Entry Grid.Column="1" x:Name="NuevaClaveEntry" Placeholder="Escribe tu nueva contraseña" IsPassword="True" TextColor="#FFFFFF" PlaceholderColor="#4A4C5A" BackgroundColor="Transparent" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="CONFIRMAR CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#00E5FF" CharacterSpacing="1" />
                                <Border BackgroundColor="#0B0C10" Stroke="#2B2C36" StrokeThickness="1" Padding="14,4" StrokeShape="RoundRectangle 16" HeightRequest="56">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Text="🔐" FontSize="20" VerticalOptions="Center" TextColor="#00E5FF"/>
                                        <Entry Grid.Column="1" x:Name="ConfirmarNuevaClaveEntry" Placeholder="Repite la contraseña" IsPassword="True" TextColor="#FFFFFF" PlaceholderColor="#4A4C5A" BackgroundColor="Transparent" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                                <Button Text="GUARDAR CONTRASEÑA" Clicked="OnCambiarClaveClicked" BackgroundColor="#00E676" TextColor="#0B0C10" FontSize="14" FontAttributes="Bold" HeightRequest="56" CornerRadius="16" CharacterSpacing="1" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>