<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ViandriveApp.Views.Usuario"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi perfil"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#000000">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ENCABEZADO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#121212"
            StrokeThickness="0"
            Padding="22,38,22,25">

            <VerticalStackLayout Spacing="7">
                <Label
                    Text="VIANDRIVE"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#F5B800"
                    CharacterSpacing="2" />

                <Label
                    Text="Mi perfil"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF" />

                <Label
                    x:Name="lblBienvenida"
                    Text="Información de tu cuenta"
                    FontSize="14"
                    TextColor="#A0A0A0" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,20,18,25" Spacing="16">

                <!-- TARJETA DE PERFIL -->
                <Border
                    BackgroundColor="#121212"
                    Stroke="#2A2A2A"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <!-- AVATAR -->
                        <Border
                            WidthRequest="90"
                            HeightRequest="90"
                            BackgroundColor="#1A1A1A"
                            Stroke="#F5B800"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 45"
                            HorizontalOptions="Center">

                            <Label
                                x:Name="lblInicial"
                                Text="U"
                                FontSize="38"
                                FontAttributes="Bold"
                                TextColor="#F5B800"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            x:Name="lblNombre"
                            Text="Cargando..."
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            HorizontalOptions="Center" />

                        <Label
                            x:Name="lblCorreo"
                            Text="correo@ejemplo.com"
                            FontSize="14"
                            TextColor="#A0A0A0"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ESTADÍSTICAS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        BackgroundColor="#121212"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="CALIFICACIÓN" FontSize="11" FontAttributes="Bold" TextColor="#808080" HorizontalOptions="Center" />
                            <Label x:Name="lblCalificacion" Text="5.0 ★" FontSize="27" FontAttributes="Bold" TextColor="#F5B800" HorizontalOptions="Center" />
                            <Label Text="Conductores" FontSize="12" TextColor="#808080" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="#121212"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="VIAJES" FontSize="11" FontAttributes="Bold" TextColor="#808080" HorizontalOptions="Center" />
                            <Label x:Name="lblViajes" Text="0" FontSize="27" FontAttributes="Bold" TextColor="#F5B800" HorizontalOptions="Center" />
                            <Label Text="Realizados" FontSize="12" TextColor="#808080" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- INFORMACIÓN DE CUENTA -->
                <Border
                    BackgroundColor="#121212"
                    Stroke="#2A2A2A"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="14">
                        <Label Text="INFORMACIÓN DE CUENTA" FontSize="12" FontAttributes="Bold" TextColor="#F5B800" CharacterSpacing="1" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Label Text="👤" FontSize="18" />
                            <Label Grid.Column="1" x:Name="lblNombreCuenta" Text="Nombre" FontSize="15" TextColor="#FFFFFF" VerticalOptions="Center" />

                            <Label Grid.Row="1" Text="✉" FontSize="18" TextColor="#F5B800" />
                            <Label Grid.Row="1" Grid.Column="1" x:Name="lblCorreoCuenta" Text="Correo" FontSize="15" TextColor="#A0A0A0" VerticalOptions="Center" />

                            <Label Grid.Row="2" Text="📱" FontSize="18" />
                            <Label Grid.Row="2" Grid.Column="1" x:Name="lblTelefonoCuenta" Text="Teléfono" FontSize="15" TextColor="#A0A0A0" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- OPCIONES DE CONFIGURACIÓN -->
                <Label Text="CONFIGURACIÓN" FontSize="12" FontAttributes="Bold" TextColor="#F5B800" CharacterSpacing="1" Margin="3,3,0,0" />

                <!-- BOTÓN EDITAR PERFIL -->
                <Border BackgroundColor="#121212" Stroke="#2A2A2A" StrokeThickness="1" Padding="17" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="✏" FontSize="22" TextColor="#F5B800" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Editar perfil" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Modifica tus datos personales" FontSize="12" TextColor="#808080" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#808080" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="EditarPerfil_Tapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- BOTÓN CONFIGURACIÓN -->
                <Border BackgroundColor="#121212" Stroke="#2A2A2A" StrokeThickness="1" Padding="17" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="⚙" FontSize="22" TextColor="#F5B800" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Configuración" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Preferencias de la aplicación" FontSize="12" TextColor="#808080" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#808080" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Configuracion_Tapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- BOTÓN CERRAR SESIÓN -->
                <Border BackgroundColor="#121212" Stroke="#3A2525" StrokeThickness="1" Padding="17" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="↪" FontSize="22" TextColor="#EF4444" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Cerrar sesión" FontSize="16" FontAttributes="Bold" TextColor="#EF4444" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#808080" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CerrarSesion_Tapped" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER -->
        <Border Grid.Row="2" BackgroundColor="#121212" Stroke="#2A2A2A" StrokeThickness="1" Padding="18,12">
            <Label Text="VIANDRIVE • PASAJERO" FontSize="11" TextColor="#808080" HorizontalOptions="Center" />
        </Border>

        <!-- MODAL FLOATING / POPUP: EDITAR PERFIL -->
        <Grid x:Name="EditProfileModal" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False">
            <Border
                VerticalOptions="End"
                BackgroundColor="#121212"
                Stroke="#2A2A2A"
                StrokeThickness="1"
                Padding="22"
                StrokeShape="RoundRectangle 24,24,0,0">

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Editar Perfil" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" FontSize="18" TextColor="#808080" BackgroundColor="Transparent" Clicked="OnCancelarEdicionClicked" />
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre completo" FontSize="12" FontAttributes="Bold" TextColor="#F5B800" />
                        <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="12,2" StrokeShape="RoundRectangle 12">
                            <Entry x:Name="EditNombreEntry" TextColor="#FFFFFF" PlaceholderColor="#808080" HeightRequest="46" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Teléfono" FontSize="12" FontAttributes="Bold" TextColor="#F5B800" />
                        <Border BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="12,2" StrokeShape="RoundRectangle 12">
                            <Entry x:Name="EditTelefonoEntry" Keyboard="Telephone" TextColor="#FFFFFF" PlaceholderColor="#808080" HeightRequest="46" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        Text="GUARDAR CAMBIOS"
                        Clicked="OnGuardarPerfilClicked"
                        BackgroundColor="#F5B800"
                        TextColor="#000000"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="14"
                        Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>