<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ViandriveApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ViandriveApp.Views"
    BackgroundColor="#0B0C10"
    ForegroundColor="White"
    TitleColor="White">

    <!-- Pantalla Inicial -->
    <ShellContent
        Title="Bienvenida"
        ContentTemplate="{DataTemplate local:WelcomePage}"
        Route="WelcomePage" 
        Shell.NavBarIsVisible="False" />

    <!-- Páginas de Login registradas estructuralmente para permitir navegación absoluta -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Shell.NavBarIsVisible="False" />
    

    <ShellContent
        Route="LoginConductorPage"
        ContentTemplate="{DataTemplate local:LoginConductorPage}"
        Shell.NavBarIsVisible="False" />


    <ShellContent
     Route="MapaPage"
     ContentTemplate="{DataTemplate local:MapaPage}"
     Shell.NavBarIsVisible="True" />


</Shell>