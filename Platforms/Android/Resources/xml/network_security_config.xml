<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<base-config cleartextTrafficPermitted="false">
		<trust-anchors>
			<!-- Confía en los certificados del sistema por defecto (CA oficiales) -->
			<certificates src="system" />
			<!-- Opcional: si en algún momento necesitas probar con certificados autolesionados o de usuario en emulador -->
			<certificates src="user" />
		</trust-anchors>
	</base-config>
</network-security-config>